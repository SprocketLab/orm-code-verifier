FROM python:3.12-slim

RUN apt-get update && apt-get install -y \
    git \
    curl

# Create a non-root user with the same UID/GID as the host user
# The ARG values are defaults that can be overridden at build time
ARG USER_ID=1000
ARG GROUP_ID=1000
ARG USERNAME=appuser

RUN groupadd -g $GROUP_ID $USERNAME && \
    useradd -m -u $USER_ID -g $GROUP_ID -s /bin/bash $USERNAME

# Create and set permissions for application directory
RUN mkdir -p /app && \
    chown -R $USERNAME:$USERNAME /app

# RUN pip install git+https://github.com/gabeorlanski/simple-code-execution.git \
#     git+https://github.com/gabeorlanski/evalplus.git \
#     git+https://github.com/bigcode-project/bigcode-evaluation-harness.git

# RUN pip install datasets==2.21.0 \
#     rich==13.8.0 \
#     simple-parsing==0.1.6 \
#     cosmic-ray==8.3.15 \
#     tqdm==4.66.5 \
#     mutmut==2.5.1 \
#     black==24.8.0 \
#     hydra-core==1.3.2 \
#     accelerate==1.1.0 \
#     click==8.1.7 \
#     ujson==5.10.0


# Set working directory
WORKDIR /app

# Switch to the non-root user
USER $USERNAME
